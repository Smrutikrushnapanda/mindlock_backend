DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require
JWT_ACCESS_SECRET=replace_with_random_hex_64chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_random_hex_64chars
JWT_REFRESH_EXPIRES=30d
JWT_INVITE_SECRET=replace_with_random_hex_64chars
PORT=5000

# SMTP (Gmail example — use an App Password from Google account settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_NAME=MindLock
# NOTE: for Gmail, the From address is always rewritten to SMTP_USER (Gmail rejects other From addresses).
SMTP_FROM=MindLock <noreply@yourdomain.com>

APP_URL=https://your-backend.example.com
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=120